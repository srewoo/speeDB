{
  "name": "@speedb/mcp",
  "version": "1.2.0",
  "description": "MCP server that scans a GitHub or GitLab repo for database queries and grounds every proposed rewrite against the source. The calling agent supplies the reasoning \u2014 no API key required.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "speedb-mcp": "./dist/server.js"
  },
  "main": "./dist/server.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@speedb/core": "1.2.0",
    "zod": "^3.24.1"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sql",
    "database",
    "performance",
    "code-review"
  ]
}
