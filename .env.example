# Copy to `.env`. Read by `bench/scan.mjs` only — the extension never reads this
# file, and `.env` is gitignored.
#
# You need ONE model key. Everything else is optional.

# --- the model. One of these three is all that is required. -----------------
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...

# --- forge tokens: only needed to fetch a repo over the network. ------------
# Not needed for mt-test-studio if you pass `--path` to a local checkout.
# Not needed for the four public GitHub repos unless you hit the 60/hour
# unauthenticated rate limit.
# GITLAB_TOKEN=glpat-...
# GITHUB_TOKEN=ghp_...
