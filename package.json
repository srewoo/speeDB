{
  "name": "speedb-monorepo",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Scan any GitHub or GitLab repo for database queries and get grounded, output-identical optimisations.",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:cycles": "node packages/extension/scripts/check-cycles.mjs",
    "dev": "npm run dev -w @speedb/extension",
    "package": "npm run package -w @speedb/extension",
    "release": "npm run test && npm run bench:gate && npm run package",
    "bench": "node bench/score.mjs",
    "bench:detect": "node bench/detect.mjs",
    "bench:scan": "node bench/scan.mjs",
    "bench:pin": "node bench/pin.mjs",
    "bench:gate": "node bench/gate.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "workspaces": [
    "packages/core",
    "packages/extension",
    "packages/mcp"
  ]
}
